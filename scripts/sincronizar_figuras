#!/usr/bin/env python3
"""Trae desde trufi-data-science las figuras que cita el capítulo 7.

Cada notebook del pipeline guarda sus figuras en
resultados/0N_<fase>/figuras/<nombre>.png. Este script copia SOLO las que
cita la monografía, cada una a la carpeta de la sección donde aparece
(imagenes/07_desarrollo/7_N_*/), conservando el nombre original.
La correspondencia completa figura -> sección -> notebook está en
docs/figuras_cap7.md.

Los diagramas propios de la monografía (flujo CRISP-DM del proyecto)
se dibujan con TikZ dentro del .tex y no pasan por este script.

Uso:  scripts/sincronizar_figuras        (o:  make figuras)
Origen: $TRUFI_REPO, o ../../trufi-data-science respecto de la plantilla.
Devuelve código 1 si falta alguna figura, con la lista de faltantes.
"""
import os
import shutil
import sys

RAIZ = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
ORIGEN = os.environ.get("TRUFI_REPO",
                        os.path.join(RAIZ, "..", "..", "trufi-data-science"))

D72 = "imagenes/07_desarrollo/7_2_comprension_datos"
D73 = "imagenes/07_desarrollo/7_3_preparacion"
D74 = "imagenes/07_desarrollo/7_4_modelado"
D75 = "imagenes/07_desarrollo/7_5_evaluacion"
D76 = "imagenes/07_desarrollo/7_6_despliegue"

# (carpeta en resultados/, archivo, destino). La carpeta destino sigue la
# SECCIÓN del texto: 02_preprocesamiento y 03_feature_engineering se
# discuten juntos en 7.3 (Preparación de los datos).
MANIFIESTO = [
    ("01_eda", "area_estudio.png",                D72),
    ("01_eda", "cobertura_semanal.png",           D72),
    ("01_eda", "perfil_temporal.png",             D72),
    ("01_eda", "distancia.png",                   D72),
    ("01_eda", "gtfs_red_y_demanda.png",          D72),
    ("01_eda", "objetivo_distribucion.png",       D72),
    ("01_eda", "objetivo_vs_poblacion.png",       D72),
    ("01_eda", "lisa.png",                        D72),
    ("02_preprocesamiento", "flujo_limpieza.png",      D73),
    ("02_preprocesamiento", "consultas_por_zona.png",  D73),
    ("03_feature_engineering", "correlacion_predictores.png", D73),
    ("03_feature_engineering", "anillos_y_prueba.png",        D73),
    ("04_modelado", "comparacion_tecnicas.png",   D74),
    ("04_modelado", "calibracion_oof.png",        D74),
    ("05_evaluacion", "calibracion_deciles.png",   D75),
    ("05_evaluacion", "observado_vs_esperado.png", D75),
    ("05_evaluacion", "mapa_brecha.png",           D75),
    ("05_evaluacion", "brecha_por_cobertura.png",  D75),
    ("05_evaluacion", "sensibilidad.png",          D75),
    ("06_propuesta", "mapa_acciones.png",         D76),
    ("06_propuesta", "zonas_prioritarias.png",    D76),
]


def main():
    origen = os.path.normpath(ORIGEN)
    print(f"Origen: {origen}")
    faltan = []
    for carpeta, archivo, destino in MANIFIESTO:
        src = os.path.join(origen, "resultados", carpeta, "figuras", archivo)
        if not os.path.isfile(src):
            faltan.append(src)
            continue
        dst_dir = os.path.join(RAIZ, destino)
        os.makedirs(dst_dir, exist_ok=True)
        shutil.copy2(src, os.path.join(dst_dir, archivo))
        print(f"  [OK ] {carpeta}/{archivo:<30} -> {destino}/")
    if faltan:
        print(f"\nFaltan {len(faltan)} figura(s):")
        for f in faltan:
            print(f"  [MAL] {f}")
        return 1
    print(f"\n{len(MANIFIESTO)} figuras copiadas del pipeline.")
    return 0


if __name__ == "__main__":
    sys.exit(main())
