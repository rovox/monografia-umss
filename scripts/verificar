#!/usr/bin/env python3
"""Verificación de formato de la monografía sobre el PDF compilado.

Mide, sin dependencias externas de Python (solo poppler-utils):
  - márgenes efectivos del texto (pdftotext -bbox-layout)
  - interlineado de la prosa (distancia entre líneas consecutivas)
  - secuencia y posición de los folios (romanos/arábigos, abajo y centrados)
  - fuentes incrustadas (pdffonts): solo Arial/Liberation Sans,
    Garamond/EB Garamond e IBM Plex Mono
  - número de páginas (pdfinfo)
  - desbordes, referencias y citas indefinidas (build/main.log, build/main.blg)
  - marcadores de borrador que quedaron en el PDF ("[...]", TODO)

Uso:  scripts/verificar [main.pdf] [build/main.log]
Sale con código 1 si algún criterio queda fuera de tolerancia.
"""
import os
import re
import statistics
import subprocess
import sys
import xml.etree.ElementTree as ET

CM = 72 / 2.54  # puntos PostScript por centímetro

# Márgenes exigidos (cm) y tolerancia
MARGENES = {"izquierdo": 3.0, "derecho": 2.5, "superior": 2.5, "inferior": 2.5}
TOL_MARGEN = 0.15
# Interlineado doble real con Arial 12 (pt) y tolerancia
INTERLINEADO = 27.6
TOL_INTERLINEADO = 0.5
# Desborde máximo admitido (pt)
DESBORDE_MAX = 2.0
# Fuentes admitidas (nombre sin el prefijo de subconjunto "ABCDEF+").
# LatinModernMath: base de unicode-math declarada en preambulo.tex; solo
# aporta los símbolos que Arial no tiene (sumatorio, raíz, barra "∣"...),
# las letras y cifras de las fórmulas siguen en Arial.
FUENTES_OK = re.compile(r"^(Arial|LiberationSans|Garamond|EBGaramond|IBMPlexMono|LatinModernMath)")
# Páginas que cuentan en la serie pero NO muestran folio (guía §3.1):
# carátula, dedicatoria y agradecimientos, en ese orden.
SIN_FOLIO_INICIAL = 3
# Folio: forma admitida en el pie de página
FOLIO = re.compile(r"^(?:[ivxlcdm]{1,7}|[0-9]{1,3})$")
# Marcadores de borrador permitidos: los cuatro "[Incluya ...]" de los
# (Anexos C a F eliminados) contenido provisional que el autor dejó escrito,
# no notas internas de trabajo. Si el autor los sustituye por texto
# definitivo, este patrón deja de encontrar nada y el aviso desaparece.
# La lista se reconoce por su encabezado, no por el número de página.
MARCADERES_PERMITIDOS = re.compile(
    r"^\[(?:Incluya|pendiente de consolidar)", re.I)
# Corchetes que NO son marcadores: abreviaturas y descriptores de APA 7
# que imprime biblatex-apa ("Instituto Nacional de Estadística [INE]",
# "[Ponencia]", "[Documentación de software]"...) y corchetes de fórmulas
# del Marco teórico (esperanza condicional E[Y ∣ P, X], término de sesgo).
CORCHETES_LEGITIMOS = re.compile(
    r"^\[(?:[A-Z]{2,8}\]|Ponencia|Documentación de software|Publicación en el sitio"
    r"|Ficha de la aplicación|Conjunto de datos|Software|Sesgo\()|∣")


def roman(n):
    """Convierte 1..20 en romanos minúscula (para comprobar la serie)."""
    tabla = ((10, "x"), (9, "ix"), (5, "v"), (4, "iv"), (1, "i"))
    salida = ""
    for valor, simbolo in tabla:
        while n >= valor:
            salida += simbolo
            n -= valor
    return salida



def ejecutar(*args):
    return subprocess.run(args, capture_output=True, text=True, check=True).stdout


def paginas(pdf):
    m = re.search(r"^Pages:\s+(\d+)", ejecutar("pdfinfo", pdf), re.M)
    return int(m.group(1)) if m else 0


def leer_cajas(pdf):
    """Devuelve [(ancho, alto, [bloques [[líneas (xmin, ymin, xmax, ymax, texto)]]])]."""
    xml = ejecutar("pdftotext", "-bbox-layout", pdf, "-")
    xml = re.sub(r"<!DOCTYPE[^>]*>", "", xml)
    xml = xml.replace(' xmlns="http://www.w3.org/1999/xhtml"', "")
    raiz = ET.fromstring(xml)
    salida = []
    for pag in raiz.iter("page"):
        ancho, alto = float(pag.get("width")), float(pag.get("height"))
        bloques = []
        for bloque in pag.iter("block"):
            lineas = []
            for linea in bloque.iter("line"):
                palabras = [p for p in linea.iter("word")]
                if not palabras:
                    continue
                caja = (
                    min(float(p.get("xMin")) for p in palabras),
                    min(float(p.get("yMin")) for p in palabras),
                    max(float(p.get("xMax")) for p in palabras),
                    max(float(p.get("yMax")) for p in palabras),
                    " ".join(p.text or "" for p in palabras),
                )
                lineas.append(caja)
            if lineas:
                bloques.append(lineas)
        salida.append((ancho, alto, bloques))
    return salida


def medir_margenes(cajas):
    """Mediana por página de cada margen, excluyendo encabezado y folio,
    que viven dentro de los márgenes (no descuentan del cuerpo)."""
    zona_sup = (MARGENES["superior"] - 0.25) * CM
    zona_inf = (MARGENES["inferior"] - 0.25) * CM
    izq, der, sup, inf = [], [], [], []
    for ancho, alto, bloques in cajas:
        lineas = [l for b in bloques for l in b
                  if l[3] > zona_sup and l[1] < alto - zona_inf]
        if len(lineas) < 5:
            continue
        izq.append(min(l[0] for l in lineas) / CM)
        der.append((ancho - max(l[2] for l in lineas)) / CM)
        sup.append(min(l[1] for l in lineas) / CM)
        inf.append((alto - max(l[3] for l in lineas)) / CM)
    if not izq:
        return {}
    inf.sort()
    # Páginas "llenas": un grupo pequeño y estable (10 páginas, o el 10%
    # si el documento es más largo) en vez de un tercio del total. Un
    # tercio es sensible a la paginación exacta -- cambiar de fase mueve
    # qué páginas completan ese tercio y desplaza la mediana sin que el
    # margen real (fijo, ver \\setulmarginsandblock) haya cambiado.
    llenas = inf[: max(1, min(10, len(inf) // 10 or 1))]
    return {
        "izquierdo": statistics.median(izq),
        "derecho": statistics.median(der),
        "superior": statistics.median(sup),
        "inferior": statistics.median(llenas),
        "_minimos": {"izquierdo": min(izq), "derecho": min(der),
                     "superior": min(sup), "inferior": min(inf)},
    }


def medir_interlineado(cajas):
    """Moda de la distancia entre líneas consecutivas en cada página.

    Con interlineado doble (27,6 pt) y texto de 12 pt, poppler separa
    CADA línea en su propio <block> (el hueco entre líneas es mayor que
    lo que su heurística de agrupación espera para un mismo párrafo), así
    que agrupar por <block> subestima sistemáticamente el interlineado
    real. Se comparan en cambio líneas consecutivas de toda la página que
    se solapan horizontalmente (misma columna): el cuerpo de prosa domina
    el conteo de líneas de todo el documento, así que su espaciado es,
    por construcción, la moda global.
    """
    difs = []
    for _, _, bloques in cajas:
        lineas = sorted((l for b in bloques for l in b), key=lambda l: l[1])
        for a, b in zip(lineas, lineas[1:]):
            solape = min(a[2], b[2]) - max(a[0], b[0])
            if solape <= 0:
                continue
            d = b[3] - a[3]
            if 8 < d < 40:
                difs.append(round(d, 1))
    if not difs:
        return None, 0.0
    moda = statistics.mode(difs)
    dentro = sum(abs(d - INTERLINEADO) <= TOL_INTERLINEADO for d in difs) / len(difs)
    return moda, dentro


def modo_continuo(ruta="configuracion.tex"):
    """Lee del panel de control si la numeración es continua.

    Así el verificador valida la serie que realmente está en marcha
    (guía: romanos + arábigos; modelo: una sola serie arábiga) en vez
    de dar por hecho el modo por defecto.
    """
    if not os.path.exists(ruta):
        return False
    return bool(re.search(r"^\\numeracionContinuatrue\s*$",
                          open(ruta, encoding="utf-8").read(), re.M))


def comprobar_folios(cajas, m, continua=False):
    """Comprueba la serie y la posición de los folios (guía §3.1 y §3.2).

    Exige: las tres primeras hojas (carátula, dedicatoria y
    agradecimientos) sin folio visible; todas las demás con folio
    abajo y centrado en el bloque de texto; serie romana
    consecutiva en los preliminares y serie arábiga que arranca en
    1 en la primera hoja del cuerpo y sigue sin saltos.

    Devuelve (problemas, resumen legible).
    """
    problemas = []
    for numero, (ancho, alto, bloques) in enumerate(cajas, start=1):
        lineas = [l for b in bloques for l in b]
        # El folio vive por debajo del bloque de texto (el cuerpo nunca
        # baja de ahí), lo que además descarta como falso positivo
        # cualquier número suelto al final de una tabla.
        candidatos = [l for l in lineas
                      if l[1] > alto - 2.9 * CM and l[3] < alto - 0.8 * CM
                      and FOLIO.match(l[4].strip())]
        # Si una página llena deja su última línea dentro de la franja
        # (p. ej. el folio de una entrada del índice), el folio real es
        # siempre el número situado más abajo.
        candidatos.sort(key=lambda l: l[1], reverse=True)
        if numero <= SIN_FOLIO_INICIAL:
            if candidatos:
                problemas.append(
                    f"la hoja {numero} muestra el folio {candidatos[0][4].strip()!r} "
                    f"y la guía pide que carátula, dedicatoria y "
                    f"agradecimientos no lo muestren")
            continue
        if not candidatos:
            problemas.append(f"la hoja {numero} no tiene folio")
            continue
        # Con el folio a la derecha (interruptor) o centrado: ambos
        # valen, pero no puede quedar en otro sitio.
        izquierda = m["izquierdo"] * CM
        derecha = ancho - m["derecho"] * CM
        centro = (izquierda + derecha) / 2
        x0, x1 = candidatos[0][0], candidatos[0][2]
        centrado = abs((x0 + x1) / 2 - centro) < 0.4 * CM
        a_la_derecha = abs(x1 - derecha) < 0.4 * CM
        if not (centrado or a_la_derecha):
            problemas.append(
                f"el folio de la hoja {numero} no está centrado en el bloque "
                f"de texto (x de {x0 / CM:.2f} a {x1 / CM:.2f} cm)")

    # Serie: en modo guía, romanos consecutivos y después arábigos
    # desde 1; en modo continuo, una sola serie arábiga que arranca
    # en la hoja siguiente a las tres que no muestran folio.
    serie = []
    for numero, (ancho, alto, bloques) in enumerate(cajas, start=1):
        if numero <= SIN_FOLIO_INICIAL:
            continue
        candidatos = [l for b in bloques for l in b
                      if l[1] > alto - 2.9 * CM and l[3] < alto - 0.8 * CM
                      and FOLIO.match(l[4].strip())]
        candidatos.sort(key=lambda l: l[1], reverse=True)
        if candidatos:
            serie.append(candidatos[0][4].strip())
    arabes = [t for t in serie if t.isdigit()]
    romanos = [t for t in serie if not t.isdigit()]
    if continua:
        esperado = [str(i) for i in
                    range(SIN_FOLIO_INICIAL + 1, len(serie) + SIN_FOLIO_INICIAL + 1)]
        if serie != esperado:
            corte = next((i for i, (a, b) in enumerate(zip(serie, esperado))
                          if a != b), min(len(serie), len(esperado)))
            problemas.append(
                f"en modo continuo la serie debe seguir arábiga y consecutiva; "
                f"se esperaba {esperado[corte]!r} y hay {serie[corte]!r} en la "
                f"hoja {SIN_FOLIO_INICIAL + 1 + corte}")
        resumen = (f"continua: arábigos {serie[0] if serie else '-'}.."
                   f"{serie[-1] if serie else '-'}; "
                   f"{SIN_FOLIO_INICIAL} hojas iniciales sin folio")
        return problemas, resumen
    esperado = [roman(i) for i in range(SIN_FOLIO_INICIAL + 1, len(serie) + 1)]
    if romanos != esperado[:len(romanos)]:
        corte = next((i for i, (a, b) in enumerate(zip(romanos, esperado))
                      if a != b), min(len(romanos), len(esperado)))
        problemas.append(
            "la serie de folios romanos no es consecutiva (se esperaba "
            f"{esperado[corte]!r} y hay {romanos[corte]!r} en la hoja "
            f"{SIN_FOLIO_INICIAL + 1 + corte})")
    if arabes and arabes[0] != "1":
        problemas.append(
            f"el cuerpo debería arrancar en el folio 1 y arranca en {arabes[0]!r}")
    if arabes != [str(i + 1) for i in range(len(arabes))]:
        problemas.append("la serie de folios arábigos del cuerpo tiene saltos")
    resumen = (f"romanos {romanos[0] if romanos else '-'}..{romanos[-1] if romanos else '-'}, "
               f"arábigos 1..{arabes[-1] if arabes else '-'}; "
               f"{SIN_FOLIO_INICIAL} hojas iniciales sin folio")
    return problemas, resumen


def fuentes(pdf):
    nombres = []
    for fila in ejecutar("pdffonts", pdf).splitlines()[2:]:
        if fila.strip():
            nombres.append(fila.split()[0].split("+")[-1])
    return sorted(set(nombres))


def revisar_log(log):
    if not os.path.exists(log):
        return None
    texto = open(log, encoding="utf-8", errors="replace").read()
    desbordes = [float(x) for x in re.findall(r"Overfull \\hbox \(([\d.]+)pt too wide\)", texto)]
    indef = re.findall(r"(?:Reference|Citation) `([^']+)' .*?undefined", texto)
    indef += re.findall(r"Package biblatex Warning: The following entry could not be found", texto)
    blg = os.path.splitext(log)[0] + ".blg"
    if os.path.exists(blg):
        indef += re.findall(r"WARN - I didn't find a database entry for '([^']+)'",
                            open(blg, encoding="utf-8", errors="replace").read())
    return {
        "desbordes": desbordes,
        "graves": [d for d in desbordes if d > DESBORDE_MAX],
        "indefinidas": sorted(set(indef)),
        "rerun": "Rerun to get" in texto or "Please rerun" in texto,
    }


def marcadores(pdf):
    """Separa los marcadores de borrador bloqueantes de los permitidos.

    Devuelve (bloqueantes, permitidos): los primeros son notas internas
    o marcadores de trabajo que NO deben quedar en la entrega; los
    segundos son los placeholders que el autor dejó escritos en los
    Anexos C a F, que solo avisan.
    """
    texto = ejecutar("pdftotext", pdf, "-")
    encontrados = [re.sub(r"\s+", " ", x).strip()[:40] for x in
                   re.findall(r"\[(?:[A-ZÁÉÍÓÚÑ…][^\]]{2,400}?|…|\.\.\.)\]", texto)]
    encontrados += re.findall(r"\b(?:TODO|FIXME|XXX)\b", texto)
    bloqueantes, permitidos = [], []
    encontrados = [x for x in encontrados if not CORCHETES_LEGITIMOS.search(x)]
    for x in encontrados:
        (permitidos if MARCADERES_PERMITIDOS.match(x) else bloqueantes).append(x)
    return bloqueantes, permitidos


def main():
    pdf = sys.argv[1] if len(sys.argv) > 1 else "main.pdf"
    log = sys.argv[2] if len(sys.argv) > 2 else "build/main.log"
    if not os.path.exists(pdf):
        sys.exit(f"No existe {pdf}; compila primero.")
    fallos = []

    def informe(nombre, valor, ok):
        print(f"  [{'OK ' if ok else 'MAL'}] {nombre}: {valor}")
        if not ok:
            fallos.append(nombre)

    print(f"Verificando {pdf}")
    print(f"  Páginas: {paginas(pdf)}")

    cajas = leer_cajas(pdf)
    m = medir_margenes(cajas)
    for lado, objetivo in MARGENES.items():
        if lado not in m:
            informe(f"margen {lado}", "sin datos", False)
            continue
        valor, minimo = m[lado], m["_minimos"][lado]
        ok = abs(valor - objetivo) <= TOL_MARGEN and minimo >= objetivo - TOL_MARGEN
        informe(f"margen {lado}",
                f"{valor:.2f} cm (mínimo {minimo:.2f}; objetivo {objetivo} ± {TOL_MARGEN})", ok)

    moda, dentro = medir_interlineado(cajas)
    informe("interlineado de la prosa",
            f"{moda} pt ({dentro:.0%} de las líneas a {INTERLINEADO} ± {TOL_INTERLINEADO})",
            moda is not None and abs(moda - INTERLINEADO) <= TOL_INTERLINEADO)

    problemas, resumen_folios = comprobar_folios(cajas, m, modo_continuo())
    informe("serie y posición de los folios", resumen_folios, not problemas)
    for p in problemas[:5]:
        print(f"        - {p}")

    fs = fuentes(pdf)
    ajenas = [f for f in fs if not FUENTES_OK.match(f)]
    informe("fuentes", ", ".join(fs), not ajenas)
    if ajenas:
        print(f"        fuera de la lista: {', '.join(ajenas)}")

    r = revisar_log(log)
    if r is None:
        print(f"  (sin {log}: se omiten desbordes y referencias)")
    else:
        informe(f"desbordes > {DESBORDE_MAX} pt",
                f"{len(r['graves'])} (total Overfull: {len(r['desbordes'])})", not r["graves"])
        informe("referencias/citas indefinidas",
                ", ".join(r["indefinidas"]) or "0", not r["indefinidas"])
        if r["rerun"]:
            print("  [AVISO] el log pide otra pasada de compilación")

    bloqueantes, permitidos = marcadores(pdf)
    informe("marcadores de borrador en el PDF",
            ", ".join(bloqueantes[:8]) or "0", not bloqueantes)
    if permitidos:
        print(f"  [AVISO] {len(permitidos)} placeholder(s) autorizado(s) de los "
              f"Anexos C-F, pendientes de contenido del autor: "
              f"{', '.join(sorted(set(permitidos))[:4])}")

    if fallos:
        print(f"\nFuera de tolerancia: {', '.join(fallos)}")
        sys.exit(1)
    print("\nTodo dentro de tolerancia.")


if __name__ == "__main__":
    main()
